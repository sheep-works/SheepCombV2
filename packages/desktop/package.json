{
  "name": "@sheep-family/desktop",
  "productName": "SheepHub Local",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/index.html', 'dist/index.html')\"",
    "dev": "pnpm run build && electron .",
    "package": "pnpm run build && electron-builder"
  },
  "build": {
    "appId": "com.sheepfamily.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@sheep-family/api": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
