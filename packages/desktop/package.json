{
  "name": "@sheep-family/desktop",
  "productName": "SheepBobbin Local",
  "version": "1.0.5",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/index.html', 'dist/index.html'); require('fs').copyFileSync('bobbin.ico', 'dist/bobbin.ico')\"",
    "dev": "pnpm run build && electron .",
    "package": "pnpm run build && electron-builder && node -e \"if(require('fs').existsSync('VersionLogs.md')) require('fs').copyFileSync('VersionLogs.md', 'release/VersionLogs.md')\""
  },
  "build": {
    "appId": "com.sheepfamily.desktop",
    "icon": "bobbin.ico",
    "win": {
      "icon": "bobbin.ico"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@sheep-family/api": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~6.0.2"
  }
}