                }
              }
            }
          }
        }
      }
    },
    "/gen/check/default": {
      "post": {
        "summary": "Process check/default (Async)",
        "description": "Asynchronously run task for category check and prompt default.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/gen/check/default/sync": {
      "post": {
        "summary": "Process check/default (Sync)",
        "description": "Synchronously run task for category check and prompt default.",
        "security": [
          {
