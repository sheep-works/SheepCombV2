        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          }
        }
      }
    },
    "/gen/trans/user/sync": {
      "post": {
        "summary": "Translate User (Sync)",
        "description": "Synchronously run translation with user parameters.",
        "security": [
