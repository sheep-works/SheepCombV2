{
  "name": "sheep-comb-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sheep-family/web dev",
    "build:web": "pnpm --filter @sheep-family/web build",
    "dev:api": "pnpm --filter @sheep-family/api run dev",
    "build:api": "pnpm --filter @sheep-family/api run build",
    "dev:desktop": "pnpm --filter @sheep-family/desktop run dev",
    "build:desktop": "pnpm --filter @sheep-family/desktop run build",
    "pack:desktop": "pnpm --filter @sheep-family/desktop run package",
    "cli": "pnpm --filter @sheep-family/cli run start",
    "test": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.0.7",
    "@xmldom/xmldom": "^0.9.10"
  }
}